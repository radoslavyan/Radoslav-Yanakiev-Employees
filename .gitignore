## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Bb]uild[Ll]og.*

# Visual Studio 2022 cache/options
.vs/
.vscode/

# Generated files
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*_i.asm
*.cachefile
*.dbmdl

# Deployment folders
publish/
out/
dist/
artifacts/
wwwroot/dist/
node_modules/
packages/

# NuGet packages
*.nupkg
# Uncomment if you want to ignore your nuget packages local cache
# *.snupkg
# The packages folder can be ignored because of `restore`
**/packages/*
!**/packages/build/
# NuGet Symbol Cache
*.snupkg

# Azure functions / local settings
local.settings.json

# DotCover
.idea/
*.dotCover

# Rider / JetBrains
.idea/
*.sln.iml

# Others
*.stackdump
*.bak
*.swp
*.DS_Store
Thumbs.db

# Publish output
*.PublishSettings
appsettings.Development.json
